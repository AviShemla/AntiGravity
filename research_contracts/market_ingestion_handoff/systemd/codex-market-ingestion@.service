[Unit]
Description=Codex Oracle guarded market ingestion for NYSE session %i
After=network-online.target
Wants=network-online.target
OnSuccess=codex-market-ingestion-postflight@%i.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/codex-oracle/market-ingestion/current/run-market-ingestion --source-session %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-oracle/market-ingestion/%i
