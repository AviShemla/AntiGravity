[Unit]
Description=Codex Oracle SELECT-only ingestion postflight for %i
After=network-online.target codex-market-ingestion@%i.service
OnSuccess=codex-market-ingestion-handoff@%i.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/codex-oracle/market-ingestion-readonly.env
ExecStart=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@/python /opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@/market_ingestion_postflight_cli.py --source-session %i --expected-code-version @INGESTION_RELEASE_SHA256@ --handoff-output /var/lib/codex-oracle/market-ingestion/%i/postflight-handoff.json --env-file /etc/codex-oracle/market-ingestion-readonly.env --attempts 6 --retry-seconds 5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@
ReadOnlyPaths=/etc/codex-oracle/market-ingestion-readonly.env
ReadWritePaths=/var/lib/codex-oracle/market-ingestion/%i
