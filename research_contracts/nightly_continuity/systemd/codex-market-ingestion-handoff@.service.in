[Unit]
Description=Terminal verification of Codex Oracle STAGING ingestion handoff for %i
After=codex-market-ingestion-postflight@%i.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@/run-market-ingestion-handoff --source-session %i --progress-marker /var/lib/codex-oracle/market-ingestion/%i/progress.json --code-version @HANDOFF_RELEASE_SHA256@ --heartbeat-seconds 30 --total-units 1 --artifact /var/lib/codex-oracle/market-ingestion/%i/postflight-handoff.json --max-age-seconds 300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@
ReadOnlyPaths=/var/lib/codex-oracle/market-ingestion/%i/postflight-handoff.json
ReadWritePaths=/var/lib/codex-oracle/market-ingestion/%i
