[Unit]
Description=Terminal verification of Codex Oracle STAGING ingestion handoff for %i
After=codex-market-ingestion-postflight@%i.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@/python /opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@/verify_postflight_handoff.py --source-session %i --artifact /var/lib/codex-oracle/market-ingestion/%i/postflight-handoff.json --max-age-seconds 300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/codex-oracle/releases/market-ingestion-handoff-@HANDOFF_RELEASE_SHA256@
ReadOnlyPaths=/var/lib/codex-oracle/market-ingestion/%i/postflight-handoff.json
