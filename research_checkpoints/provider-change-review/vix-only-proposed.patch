+def remove_known_yahoo_vix_placeholder(
+    frame: pd.DataFrame,
+    ticker: str,
+    *,
+    nyse_trading_sessions: set[date] | None,
+) -> pd.DataFrame:
+    """Remove Yahoo's known VIX placeholder only outside the NYSE calendar.
+
+    Missing calendar evidence fails closed: all Yahoo rows remain subject to
+    the strict market-data guard.
+    """
+    required = ["Open", "High", "Low", "Close", "Volume"]
+    if ticker != "^VIX" or nyse_trading_sessions is None or "Date" not in frame.columns:
+        return frame
+    if not set(required).issubset(frame.columns):
+        return frame
+
+    dates = pd.to_datetime(frame["Date"], errors="coerce").dt.date
+    def missing_or_actual_numeric_zero(value: object) -> bool:
+        """Reject text/coerced values so malformed input reaches the strict guard."""
+        if pd.isna(value):
+            return True
+        if isinstance(value, (bool, np.bool_)):
+            return False
+        if isinstance(value, (int, float, np.integer, np.floating)):
+            return bool(np.isfinite(value) and value == 0.0)
+        return False
+
+    placeholder_values = frame[required].apply(
+        lambda column: column.map(missing_or_actual_numeric_zero)
+    )
+    placeholder = (
+        dates.eq(date(2025, 11, 27))
+        & ~dates.isin(nyse_trading_sessions)
+        & placeholder_values.all(axis=1)
+    )
+    if not placeholder.any():
+        return frame
+    return frame.loc[~placeholder].copy()
 
 
