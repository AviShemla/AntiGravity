c,event_id"}]},"revision":{"revision":2,"revision_kind":"NON_CIRCULAR_AUTHORIZATION_ENVELOPE_ONLY","supersedes":{"contract_id":"oracle-research-dataset-application-freeze-v1","sha256":"127f2e5f11944b6489f28c4e6be1cede9487974e863a2da8b19ff04253716f17"}},"rollback_boundaries":{"after_freeze_commit":"Never mutate, delete, or drop frozen evidence. Disable consumers and, only with separate approval, append one REVOKE event referencing preserved evidence.","after_schema_commit_before_freeze":"Disable the unapproved read/write path logically; retain all schema objects and the APPLY event. Never DROP or DELETE evidence.","before_freeze_commit":"Issue transaction rollback; source snapshot and source lineage remain unchanged and no partial dataset version, provider binding, or FREEZE event may remain.","before_schema_begin":"Abandon the plan; production state remains unchanged.","before_schema_commit":"Issue transaction rollback and prove that neither schema objects nor APPLY ledger event exist."},"safety_gates":{"forbidden_concurrent_actions":["INGESTION_WRITE","MODEL_FIT","SNAPSHOT_VALIDATION_OR_PROMOTION","RECOMMENDATION_OR_ORDER_STAGING","TRADING_OR_EMAIL","SECOND_SCHEMA_OR_FREEZE_WRITER"],"operating_mode":"FROZEN/RESEARCH","required_inactive_disabled_units":["ag-sniper.service","antigravity-nightly.timer","antigravity-qa-watchdog.timer"],"required_inactive_units":["codex-market-ingestion-20260826-v1.service"]},"source_git_commit":"eb08ce518a557bf6b772aa66e6bad25e3d681cd3","target_database_id":"theoracle-avishe"}
